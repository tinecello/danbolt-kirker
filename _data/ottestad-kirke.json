  "hjelp": [
    {
      "q": "Mikrofonen gir ingen lyd",
      "a": "Sjekk at mikrofonen er skrudd på. Se etter om «Mute» lyser for mikrofonen på styringspanelet. Blinker lampen på mikrofonen, må batteriet byttes."
    },
    {
      "q": "Det hyler eller piper",
      "a": "Skyv feideren for mikrofonen litt ned på styringspanelet. Ikke gå rett foran høyttalerne med mikrofonen."
    },
    {
      "q": "Skjermen på styringspanelet er svart",
      "a": "Trykk på skjermen. Er den fortsatt svart, sjekk at nettverkskabelen sitter godt i styringspanelet, og at strømmen til hele lydanlegget er slått på. Hjelper ikke det, kontakt kirkens kontaktperson."
    },
    {
      "q": "Det kommer ingen lyd fra mikseren",
      "a": "Sjekk at feideren «Ekstern mikser» er skjøvet opp og ikke står på «Mute», og at kablene fra mikseren sitter i."
    },
    {
      "q": "Må vi justere lyden underveis?",
      "a": "Nei. Lyden er innstilt for hele kirken. Bruk feiderne bare hvis noe er for svakt eller for sterkt."
    }
  ],
