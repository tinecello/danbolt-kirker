  "hjelp": [
    {
      "q": "Mikrofonen gir ingen lyd",
      "a": "Sjekk at mikrofonen er skrudd på. Se etter om «Mute» lyser for mikrofonen på panelet. Blinker lampen på mikrofonen, må batteriet byttes."
    },
    {
      "q": "Det hyler eller piper",
      "a": "Skyv mikrofonen litt ned på panelet. Ikke gå rett foran høyttalerne med mikrofonen."
    },
    {
      "q": "Skjermen på panelet er svart",
      "a": "Trykk på skjermen. Hjelper ikke det, ring teknisk support."
    },
    {
      "q": "Det kommer ingen lyd fra mikseren",
      "a": "Sjekk at «Ekstern mikser» er valgt på panelet, og at kablene står i kontaktene merket V og H."
    },
    {
      "q": "Må vi justere lyden underveis?",
      "a": "Nei. Lyden er innstilt for hele kirken. Bruk skyverne bare hvis noe er for svakt eller for sterkt."
    }
  ],
